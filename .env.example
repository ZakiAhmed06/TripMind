# TripMind Environment Configuration

# Application
APP_NAME=TripMind
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api

# Server
HOST=127.0.0.1
PORT=8000

# Security & JWT
SECRET_KEY=tripmind-super-secret-production-quality-key-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for local seamless plug-and-play development
DATABASE_URL=sqlite:///./tripmind.db
# PostgreSQL alternative (uncomment for docker/postgres deployment):
# DATABASE_URL=postgresql://tripmind:tripmind123@localhost:5432/tripmind_db

# Google Gemini API
# Replace with your actual Gemini API key for live LLM responses
# When empty or invalid, TripMind automatically operates in graceful offline fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Open-Meteo Weather API (free, no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
